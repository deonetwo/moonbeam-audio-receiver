<ui:FluentWindow x:Class="MoonbeamAudioReceiver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:converters="clr-namespace:MoonbeamAudioReceiver.Converters"
        xmlns:viewmodels="clr-namespace:MoonbeamAudioReceiver.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="Moonbeam Audio Receiver"
        Height="680" Width="520"
        MinWidth="460" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="pack://application:,,,/MoonbeamAudioReceiver;component/Assets/app.ico">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />

        <!-- Waveform pulse animation -->
        <Storyboard x:Key="WaveformAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height" From="6" To="26" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height" From="12" To="32" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height" From="16" To="36" Duration="0:0:0.55" />
            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height" From="8" To="28" Duration="0:0:0.40" />
            <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height" From="12" To="32" Duration="0:0:0.50" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Moonbeam Audio Receiver"
                        IconSource="pack://application:,,,/MoonbeamAudioReceiver;component/Assets/app.ico"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Moonbeam" Click="TrayMenu_Open_Click" />
                    <MenuItem Header="Disconnect Audio" Command="{Binding DisconnectCurrentCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayMenu_Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Custom TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source="pack://application:,,,/MoonbeamAudioReceiver;component/Assets/app_logo.png"
                           Width="18" Height="18"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Moonbeam Audio Receiver"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <!-- 0. Hero Status Card (Fixed minimum height to prevent layout jumps) -->
                <RowDefinition Height="Auto" />
                <!-- 1. Device Section Header -->
                <RowDefinition Height="Auto" />
                <!-- 2. Device List / Empty State -->
                <RowDefinition Height="*" />
                <!-- 3. Preferences Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Hero Status Card -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16"
                    MinHeight="92"
                    Margin="0,0,0,16">
                <Grid VerticalAlignment="Center">
                    <!-- Active Streaming State -->
                    <Grid Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#107C41"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="STREAMING"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                </Border>
                                <TextBlock Text="{Binding StreamingDurationText}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding ConnectedDeviceName}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Rendering audio to default PC output"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Audio Waveform Visualization & Disconnect -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Animated Waveform Bars -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Height="36">
                                <Border x:Name="Bar1" Width="4" Height="12" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Margin="2,0" VerticalAlignment="Center" />
                                <Border x:Name="Bar2" Width="4" Height="18" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Margin="2,0" VerticalAlignment="Center" />
                                <Border x:Name="Bar3" Width="4" Height="24" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Margin="2,0" VerticalAlignment="Center" />
                                <Border x:Name="Bar4" Width="4" Height="16" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Margin="2,0" VerticalAlignment="Center" />
                                <Border x:Name="Bar5" Width="4" Height="10" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Margin="2,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <ui:Button Content="Disconnect"
                                       Command="{Binding DisconnectCurrentCommand}"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Idle / Connecting State -->
                    <Grid Visibility="{Binding IsStreaming, Converter={StaticResource InvBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                            <ui:SymbolIcon Symbol="Bluetooth24"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Bluetooth Receiver"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         Margin="0,6,0,0"
                                         Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. Device Section Header -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="NEARBY &amp; PAIRED BLUETOOTH DEVICES"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button ToolTip="Scan for Bluetooth devices"
                               Command="{Binding RefreshDevicesCommand}"
                               Appearance="Transparent"
                               Padding="6"
                               Height="32" Width="32"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" />
                    </ui:Button>
                    <ui:Button Content="Windows Settings"
                               Command="{Binding OpenBluetoothSettingsCommand}"
                               Appearance="Secondary"
                               Padding="10,0"
                               Height="32"
                               FontSize="12"
                               VerticalAlignment="Center">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Open24" FontSize="13" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 3. Device List -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <!-- Empty State -->
                <Border Visibility="{Binding HasDevices, Converter={StaticResource InvBoolToVis}}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <ui:SymbolIcon Symbol="PhoneLaptop24"
                                           FontSize="36"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10" />
                            <TextBlock Text="Scanning for Bluetooth devices..."
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Text="Make sure Bluetooth is turned on on your phone, tablet, or PC and set to discoverable/pairing mode."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,6,0,16" />
                            <ui:Button Content="Open Windows Bluetooth Settings"
                                       Command="{Binding OpenBluetoothSettingsCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Center"
                                       Height="36"
                                       Padding="16,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Populated Device List -->
                <ScrollViewer Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:DeviceItemViewModel}">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        MinHeight="66"
                                        Margin="0,0,0,8">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Device Icon -->
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="18"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Phone24"
                                                           FontSize="17"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Device Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="210" />
                                                <!-- Favorited Gold Star badge next to name -->
                                                <ui:SymbolIcon Symbol="Star24"
                                                               Filled="True"
                                                               FontSize="12"
                                                               Foreground="#F59E0B"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="Favorite auto-connect device"
                                                               Visibility="{Binding IsPreferred, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Status indicators -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <!-- Paired & Connected -->
                                                <TextBlock Text="Streaming"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="#107C41"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />

                                                <!-- Paired & Disconnected -->
                                                <Grid Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">
                                                    <TextBlock Text="Paired - Ready to connect"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}" />
                                                    <!-- Unpaired / Ready to pair -->
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            Visibility="{Binding IsPaired, Converter={StaticResource InvBoolToVis}}">
                                                        <TextBlock Text="Ready to pair"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Favorite / Star Toggle Button (only for paired devices) -->
                                            <ui:Button Command="{Binding TogglePreferredCommand}"
                                                       Appearance="Transparent"
                                                       Padding="6"
                                                       Height="32" Width="32"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <!-- Filled Gold Star when favorited -->
                                                    <ui:SymbolIcon Symbol="Star24"
                                                                   Filled="True"
                                                                   FontSize="16"
                                                                   Foreground="#F59E0B"
                                                                   ToolTip="Favorite auto-connect device (Click to remove)"
                                                                   Visibility="{Binding IsPreferred, Converter={StaticResource BoolToVis}}" />
                                                    <!-- Outline Star when not favorited -->
                                                    <ui:SymbolIcon Symbol="Star24"
                                                                   Filled="False"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   ToolTip="Set as favorite auto-connect device"
                                                                   Visibility="{Binding IsPreferred, Converter={StaticResource InvBoolToVis}}" />
                                                </Grid>
                                            </ui:Button>

                                            <!-- 1. Pair Button (for unpaired devices) -->
                                            <ui:Button Content="Pair"
                                                       Command="{Binding PairCommand}"
                                                       Appearance="Primary"
                                                       Height="32"
                                                       Padding="14,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsPaired, Converter={StaticResource InvBoolToVis}}"
                                                       IsEnabled="{Binding IsPairing, Converter={StaticResource InvBool}}" />

                                            <!-- 2. Connect Button (for paired devices when disconnected) -->
                                            <Grid Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}">
                                                <ui:Button Content="Connect"
                                                           Command="{Binding ConnectCommand}"
                                                           Appearance="Primary"
                                                           Height="32"
                                                           Padding="14,0"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}"
                                                           IsEnabled="{Binding IsConnecting, Converter={StaticResource InvBool}}" />

                                                <!-- 3. Disconnect Button (when connected) -->
                                                <ui:Button Content="Disconnect"
                                                           Command="{Binding DisconnectCommand}"
                                                           Appearance="Secondary"
                                                           Height="32"
                                                           Padding="14,0"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 4. Footer & Preferences -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Content="Auto-connect preferred device"
                              IsChecked="{Binding AutoConnect}"
                              FontSize="12"
                              Margin="0,4,20,4" />
                    <CheckBox Content="Minimize to tray on close"
                              IsChecked="{Binding MinimizeToTray}"
                              FontSize="12"
                              Margin="0,4,0,4" />
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
